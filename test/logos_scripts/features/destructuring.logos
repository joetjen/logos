;; Feature test: destructuring in let/defn/defn- -- vector (positional,
;; &-rest, :as) and map (:keys, explicit name/key pairs, :as) patterns,
;; nested, across single- and multi-arity defn.

(require '[logos.test :refer [:all]])
(deftest let-vector-destructuring
  (do
    (assert= (let [[a b c] (list 1 2 3)] (list a b c)) (list 1 2 3))
    (assert= (let [[a & more] (list 1 2 3 4)] (list a more)) (list 1 (list 2 3 4)))
    (assert=
      (let [[a & more :as whole] (list 1 2 3)] (list a more whole))
      (list 1 (list 2 3) (list 1 2 3)))
    (assert= (let [[[a b] c] (list (list 1 2) 3)] (list a b c)) (list 1 2 3))))
(deftest let-map-destructuring
  (do
    (assert= (let [{:keys [a b]} {:a 1 :b 2}] (+ a b)) 3)
    (assert= (let [{x :a y :b} {:a 1 :b 2}] (+ x y)) 3)
    (assert= (let [{:keys [a] :as m} {:a 1 :b 2}] (list a (:b m))) (list 1 2))))
(deftest defn-single-arity-destructuring
  (do
    (defn destructuring-test-add-pair [[a b]] (+ a b))
    (assert= (destructuring-test-add-pair (list 1 2)) 3)
    (defn destructuring-test-greet [greeting {:keys [name]}]
      (str greeting ", " name))
    (assert= (destructuring-test-greet "Hi" {:name "Jan"}) "Hi, Jan")))
(deftest defn-multi-arity-destructuring
  (do
    (defn destructuring-test-multi
      ([x] x)
      ([[a b] c] (list a b c)))
    (assert= (destructuring-test-multi 5) 5)
    (assert= (destructuring-test-multi (list 1 2) 3) (list 1 2 3))))
(deftest defn-private-destructuring
  (do
    (defn- destructuring-test-secret [[a b]] (+ a b))
    (assert= (destructuring-test-secret (list 1 2)) 3)))
(run-tests)
