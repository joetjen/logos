;; Feature test: logos.seq works on every collection shape now (list,
;; vector, map, set, nil), not just lists, plus every new function that
;; landed alongside that -- nth/second/last, some/every?, distinct,
;; sort/sort-by, frequencies/group-by, range/repeat, conj/peek/pop.

(require '[logos.test :refer [:all]])
(deftest every-shape-works-everywhere
  (do
    (assert= (map inc [1 2 3]) (list 2 3 4))
    (assert= (filter even? [1 2 3 4]) (list 2 4))
    (assert= (reduce + [1 2 3]) 6)
    (assert= (count #{1 2 3}) 3)
    (assert= (count {:a 1 :b 2}) 2)
    (assert (empty? []))
    (assert (empty? {}))
    (assert (empty? #{}))))
(deftest nth-second-last
  (do
    (assert= (nth (list 10 20 30) 1) 20)
    (assert= (nth (list 10 20 30) 9 :missing) :missing)
    (assert-throws :index-out-of-bounds (nth (list 10 20 30) 9))
    (assert= (second (list 1 2 3)) 2)
    (assert= (last (list 1 2 3)) 3)))
(deftest some-and-every
  (do
    (assert= (some even? (list 1 3 4)) true)
    (assert= (some even? (list 1 3 5)) nil)
    (assert (every? pos? (list 1 2 3)))
    (assert= (every? pos? (list 1 -2 3)) false)))
(deftest distinct-and-sort
  (do
    (assert= (distinct (list 3 1 3 2 1)) (list 3 1 2))
    (assert= (sort (list 3 1 2)) (list 1 2 3))
    (assert= (sort-by (fn [x] (- 0 x)) (list 1 3 2)) (list 3 2 1))))
(deftest frequencies-and-group-by
  (do
    (assert= (get (frequencies (list 1 1 2)) 1) 2)
    (assert= (get (frequencies (list 1 1 2)) 2) 1)
    (assert= (get (group-by even? (list 1 2 3 4)) true) [2 4])
    (assert= (get (group-by even? (list 1 2 3 4)) false) [1 3])))
(deftest range-and-repeat
  (do
    (assert= (range 3) (list 0 1 2))
    (assert= (range 1 4) (list 1 2 3))
    (assert= (range 0 6 2) (list 0 2 4))
    (assert= (repeat 3 :x) (list :x :x :x))
    (assert-throws :invalid-range-step (range 0 5 0))))
(deftest conj-peek-pop
  (do
    (assert= (conj (list 1 2) 3) (list 3 1 2))
    (assert= (conj [1 2] 3) [1 2 3])
    (assert= (peek (list 1 2 3)) 1)
    (assert= (peek [1 2 3]) 3)
    (assert= (pop (list 1 2 3)) (list 2 3))
    (assert= (pop [1 2 3]) [1 2])))
(run-tests)
