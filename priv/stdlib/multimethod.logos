;; priv/stdlib/multimethod.logos
;;
;; `logos.multimethod` -- ad-hoc polymorphism: `defmulti`/`defmethod`,
;; real Clojure semantics. Referred into `logos.core` (like `logos.seq`/
;; `logos.map`/`logos.concurrency`, unlike `logos.test`) -- this is a
;; core language capability, not a testing-only tool, so every
;; multimethod defined anywhere is callable unqualified from anywhere.
;;
;; Dispatch is on the result of calling an arbitrary "dispatch function"
;; with the multimethod's own arguments -- strictly more general than
;; single-dispatch-on-first-argument-type protocols (which this file
;; deliberately does NOT provide; see ROADMAP.md for that separate,
;; still-open design question). No hierarchy support (`isa?`/`derive`/
;; `prefer-method`) and no `remove-method`/`methods`/`get-method`
;; introspection -- real Clojure features, out of scope for a first
;; pass; `:default` alone covers the overwhelming majority of real
;; multimethod usage.
;;
;; `multimethod-registry` is a single, shared, plain re-`def`'d map var
;; (`name -> {:dispatch-fn f :methods {dispatch-val -> method-fn}}`),
;; mutated via `intern-var!`'s explicitly-qualified form -- deliberately
;; NOT an atom, the same design choice `logos.test`'s own
;; `test-registry` already made and documented: nothing here is
;; genuinely concurrent (registration and dispatch both run in whatever
;; process calls them, one at a time), and an atom-backed shared
;; registry has a real, previously-hit bootstrap failure mode (see
;; `test.logos`'s own header comment) this design avoids entirely by
;; construction. `register-multimethod!`/`register-method!` are
;; ordinary (non-syntax-quoted) functions doing the actual mutation --
;; `deftest`/`register-test!`'s own split, kept here for consistency
;; even though the specific same-file-forward-reference hazard that
;; motivated it in `test.logos` (a same-file `use` earlier in the file)
;; doesn't apply to this one.

(def multimethod-registry {})
(defn register-multimethod!
  "Registers `name` as a multimethod dispatching via `dispatch-fn`,
  starting with no methods -- the actual mutation `defmulti`'s expansion
  calls."
  [name dispatch-fn]
  (intern-var! 'logos.multimethod/multimethod-registry
    ;; `{:dispatch-fn dispatch-fn :methods {}}` (a literal) would NOT
    ;; evaluate `dispatch-fn` -- Logos map literals are self-evaluating
    ;; with UNEVALUATED elements, so that would store the literal symbol
    ;; `dispatch-fn`, not the function value bound to it (a real bug,
    ;; caught here by an actual `mix run` smoke test). `assoc` from `{}`
    ;; instead.
    (assoc multimethod-registry name (assoc {} :dispatch-fn dispatch-fn :methods {}))))
(defn register-method!
  "Registers `method-fn` as `name`'s implementation for `dispatch-val`
  -- the actual mutation `defmethod`'s expansion calls."
  [name dispatch-val method-fn]
  (intern-var! 'logos.multimethod/multimethod-registry
    (let [entry (get multimethod-registry name)]
      (assoc multimethod-registry name
        (assoc entry :methods (assoc (get entry :methods) dispatch-val method-fn))))))
(defn dispatch-multimethod
  "Looks up `name`'s registered dispatch-fn, calls it with `args` to get
  a dispatch value, then calls whichever method matches that value (or
  `:default`) with `args` -- the actual dispatch `defmulti`'s expanded
  `name` function calls on every invocation."
  [name args]
  (let [entry (get multimethod-registry name)
      methods (get entry :methods)
      dispatch-val (apply (get entry :dispatch-fn) args)
      method (get methods dispatch-val (get methods :default))]
    (if (nil? method)
      (throw :no-method-for-dispatch-value (list :multimethod name :dispatch-value dispatch-val))
      (apply method args))))
(defmacro defmulti
  "Defines a multimethod: `(name args...)` computes `(dispatch-fn
  args...)` and calls whichever `defmethod` was registered for that
  value (`:default`, if registered and nothing else matches; otherwise
  throws `:no-method-for-dispatch-value`). `defmethod` calls registered
  after `defmulti` take effect immediately, no redefinition needed."
  [name dispatch-fn]
  `(do
    (register-multimethod! (quote ~name) ~dispatch-fn)
    (defn ~name [& args#] (dispatch-multimethod (quote ~name) args#))))
(defmacro defmethod
  "Registers an implementation of `name` (already `defmulti`'d) for
  when its dispatch-fn produces `dispatch-val` -- `:default` is a
  reserved dispatch-val matched when nothing else does."
  [name dispatch-val params & body]
  `(register-method! (quote ~name) ~dispatch-val (fn ~params ~@body)))
